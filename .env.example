# Browser-safe Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Never prefix this name with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only discovery reduction; live admin membership is still mandatory.
# Set a private numeric value of 6–32 digits. Never publish the production value.
ADMIN_ROUTE_CODE=

# Server-only OpenAI credential
OPENAI_API_KEY=your-openai-api-key

# Staged diagram-aware grading + four-mark Practice pilot. Off by default.
# Build-time public setting is also enforced by the server; rebuild when changing it.
NEXT_PUBLIC_DIAGRAM_ASSESSMENT_ENABLED=false
